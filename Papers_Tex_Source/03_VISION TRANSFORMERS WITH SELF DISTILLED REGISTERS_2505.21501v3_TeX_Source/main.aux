\newlabel{fig:ablation_reg}{{5a}{8}{\textbf {Registers' behavior.} This plot illustrates adding registers improve PH-Reg teacher performance. In the blue settings, only registers are unfreezed. The green settings represent the improvements when positional embeddings are unlocked additionally. The red settings represent performance of unlocking more layers}{figure.caption.12}{}}
\newlabel{sub@fig:ablation_reg}{{a}{8}{\textbf {Registers' behavior.} This plot illustrates adding registers improve PH-Reg teacher performance. In the blue settings, only registers are unfreezed. The green settings represent the improvements when positional embeddings are unlocked additionally. The red settings represent performance of unlocking more layers}{figure.caption.12}{}}
\newlabel{fig:ablation_num_of_aug}{{5b}{8}{\textbf {Augmentations improves cosine similarity.} The plot illustrates how increasing the number of augmentations improves the alignment of the model's predictions with the target of 200 augmentations' features, as measured by cosine similarity}{figure.caption.12}{}}
\newlabel{sub@fig:ablation_num_of_aug}{{b}{8}{\textbf {Augmentations improves cosine similarity.} The plot illustrates how increasing the number of augmentations improves the alignment of the model's predictions with the target of 200 augmentations' features, as measured by cosine similarity}{figure.caption.12}{}}
