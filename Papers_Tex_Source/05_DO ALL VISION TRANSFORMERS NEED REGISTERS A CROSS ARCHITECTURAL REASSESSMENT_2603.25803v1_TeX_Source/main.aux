\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Feature maps generated by five sample images, for DINOv2-S, DINOv2-L, DeiT3-M, and OpenCLIP-B. We extract the tokens from the queries, keys, and value matrices of the last block, as well as the output tokens before the last LayerNorm of the last block. Computed in high resolution for better visualization.}}{19}{figure.caption.23}\protected@file@percent }
\newlabel{fig:app_figure_qkv}{{8}{19}{Feature maps generated by five sample images, for DINOv2-S, DINOv2-L, DeiT3-M, and OpenCLIP-B. We extract the tokens from the queries, keys, and value matrices of the last block, as well as the output tokens before the last LayerNorm of the last block. Computed in high resolution for better visualization}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Feature maps generated per block layer for DINOv2-L. We observe that the resulting feature map representation starts to worsen after the mid-blocks. However, we notice that it starts to improve for a few blocks before being dominated again by artifacts.}}{20}{figure.caption.24}\protected@file@percent }
\newlabel{fig:app_figure_qkv_per_block}{{9}{20}{Feature maps generated per block layer for DINOv2-L. We observe that the resulting feature map representation starts to worsen after the mid-blocks. However, we notice that it starts to improve for a few blocks before being dominated again by artifacts}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The cosine similarity plot of each PVTv2 variant. We see that they are all different from the ones seen in Figure~\ref {fig:cosine_plot} and therefore we choose an alternate motivation for our subsequent experiments.}}{20}{figure.caption.25}\protected@file@percent }
\newlabel{fig:pvt_cosine_similarities}{{10}{20}{The cosine similarity plot of each PVTv2 variant. We see that they are all different from the ones seen in Figure~\ref {fig:cosine_plot} and therefore we choose an alternate motivation for our subsequent experiments}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Trained position predictor evaluated using outliers at different thresholds. Outliers are designated progressively, starting from the top 50\% tokens in terms of norm down to the top 2\%. The top-1 accuracy for each evaluation is plotted, clearly showing that tokens with higher norms contain more positional information.}}{21}{figure.caption.28}\protected@file@percent }
\newlabel{fig:pvt_b2_acc_vs_percentile}{{11}{21}{Trained position predictor evaluated using outliers at different thresholds. Outliers are designated progressively, starting from the top 50\% tokens in terms of norm down to the top 2\%. The top-1 accuracy for each evaluation is plotted, clearly showing that tokens with higher norms contain more positional information}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Top row: Feature maps of the input image generated by DINOv2-Base, DeiT3-Small, and OpenCLIP-Base models. Bottom row: L2 norm distributions of output tokens computed over 5,000 ImageNet-1k validation images. The feature map quality degrades as the norm distribution grows more pronouncedly long-tailed (increasing noise), with fully artifactual patterns emerging in cases of bimodal distributions, as observed in OpenCLIP-B.}}{21}{figure.caption.29}\protected@file@percent }
\newlabel{fig:figure_feat_maps_norms}{{12}{21}{Top row: Feature maps of the input image generated by DINOv2-Base, DeiT3-Small, and OpenCLIP-Base models. Bottom row: L2 norm distributions of output tokens computed over 5,000 ImageNet-1k validation images. The feature map quality degrades as the norm distribution grows more pronouncedly long-tailed (increasing noise), with fully artifactual patterns emerging in cases of bimodal distributions, as observed in OpenCLIP-B}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Feature maps for each DINOv2 variant.}}{22}{figure.caption.30}\protected@file@percent }
