\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Results for the position prediction task. Bold numbers indicate superior performance. We prioritize top-1 accuracy over average L2 distance, as the latter is susceptible to trivial solutions (e.g., always predicting the image center), especially under uniform distributions like ours. We report this trivial solution in the Baseline column for each model. Notably, for DINOv2-S, differences are minor, consistent with its lack of artifacts. OpenCLIP-B and particularly DINOv2-G support the findings of \citet  {darcet2024registers}, where outlier tokens underperform normal tokens in position prediction. DeiT3-M and Swin-S exhibit contradictory results, with normal tokens showing higher top-1 accuracy despite worse average L2 distance. PVT-b2 achieves remarkable results, attaining 100\% top-1 accuracy and 0 average distance. }}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:pos_pred_results}{{1}{8}{Results for the position prediction task. Bold numbers indicate superior performance. We prioritize top-1 accuracy over average L2 distance, as the latter is susceptible to trivial solutions (e.g., always predicting the image center), especially under uniform distributions like ours. We report this trivial solution in the Baseline column for each model. Notably, for DINOv2-S, differences are minor, consistent with its lack of artifacts. OpenCLIP-B and particularly DINOv2-G support the findings of \citet {darcet2024registers}, where outlier tokens underperform normal tokens in position prediction. DeiT3-M and Swin-S exhibit contradictory results, with normal tokens showing higher top-1 accuracy despite worse average L2 distance. PVT-b2 achieves remarkable results, attaining 100\% top-1 accuracy and 0 average distance}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Results for the pixel reconstruction task. Bold numbers denote superior performance. Normal tokens generally exhibit a lower L2 error, except in Swin-S where outliers perform better. PVT-b2 and Swin-S show significantly larger values which show that pyramid architecture models do not perform well in pixel reconstruction tasks.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:pixel_recon_results}{{2}{8}{Results for the pixel reconstruction task. Bold numbers denote superior performance. Normal tokens generally exhibit a lower L2 error, except in Swin-S where outliers perform better. PVT-b2 and Swin-S show significantly larger values which show that pyramid architecture models do not perform well in pixel reconstruction tasks}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Image classification performance across all models. Bold numbers denote the highest score per model. Underlined values highlight the better of the two patch-based representations (Normal vs.\ Outlier).}}{8}{table.caption.13}\protected@file@percent }
\newlabel{tab:image_classification_results}{{3}{8}{Image classification performance across all models. Bold numbers denote the highest score per model. Underlined values highlight the better of the two patch-based representations (Normal vs.\ Outlier)}{table.caption.13}{}}
\citation{darcet2024registers}
\citation{darcet2024registers}
\citation{darcet2024registers}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cosine similarity plot of DINOv2-G with additional models. We include DeiT3-M and OpenCLIP-B, which exhibit similar behavior to DINOv2-G, and DINOv2-S, which lack artifacts, further validating the observed patterns. The figures demonstrate that cosine similarity is highest for normal patches in DINOv2-S, whereas in the other three models, outlier patches exhibit greater similarity. These results align with expectations, support the claims of \citet  {darcet2024registers}, and extend them to additional models. Moreover, we also include Swin-S and PVTv2-b2. Both show an alternate behavior than the other ViTs, however, PVTv2-b2 is the only one that does not depict high cosine similarity for either normal or outlier patches. }}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cosine_plot}{{3}{9}{Cosine similarity plot of DINOv2-G with additional models. We include DeiT3-M and OpenCLIP-B, which exhibit similar behavior to DINOv2-G, and DINOv2-S, which lack artifacts, further validating the observed patterns. The figures demonstrate that cosine similarity is highest for normal patches in DINOv2-S, whereas in the other three models, outlier patches exhibit greater similarity. These results align with expectations, support the claims of \citet {darcet2024registers}, and extend them to additional models. Moreover, we also include Swin-S and PVTv2-b2. Both show an alternate behavior than the other ViTs, however, PVTv2-b2 is the only one that does not depict high cosine similarity for either normal or outlier patches}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {paragraph}{Claim 5}{9}{section*.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Reproduced ImageNet-1K classification results for the DINOv2 family. Bold numbers indicate superior top-1 accuracy (\%). The results demonstrate that incorporating register tokens into the input layer does not degrade performance; instead, it consistently leads to a marginal improvement, confirming the results of \citet  {darcet2024registers}.}}{9}{table.caption.15}\protected@file@percent }
\newlabel{tab:dino_results}{{4}{9}{Reproduced ImageNet-1K classification results for the DINOv2 family. Bold numbers indicate superior top-1 accuracy (\%). The results demonstrate that incorporating register tokens into the input layer does not degrade performance; instead, it consistently leads to a marginal improvement, confirming the results of \citet {darcet2024registers}}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Top-1 accuracy on the validation set for different image representations and DINOv2 model sizes. Bold numbers indicate superior performance. \textit  {PM} refers to patch mean, \textit  {reg} to register. The addition of register tokens does not appear to enhance classification performance, as the standard approach (CLS+PM) outperforms the alternatives that employ registers. The large model constitutes an exception, however the improvement is marginal and potentially due to stochasticity. Results using the pretrained head are also included for reference.}}{9}{table.caption.15}\protected@file@percent }
\newlabel{tab:extension}{{5}{9}{Top-1 accuracy on the validation set for different image representations and DINOv2 model sizes. Bold numbers indicate superior performance. \textit {PM} refers to patch mean, \textit {reg} to register. The addition of register tokens does not appear to enhance classification performance, as the standard approach (CLS+PM) outperforms the alternatives that employ registers. The large model constitutes an exception, however the improvement is marginal and potentially due to stochasticity. Results using the pretrained head are also included for reference}{table.caption.15}{}}
\citation{darcet2024registers}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces L2-norm distributions of OpenCLIP-H and OpenCLIP-B. Despite its smaller size, the base model exhibits significantly higher L2-norm values compared to the larger variant, indicating a greater susceptibility to artifacts. This further supports the observation that smaller models are affected by high-norm tokens. In some cases like this one, they can be more affected.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:norm_distribution}{{4}{10}{L2-norm distributions of OpenCLIP-H and OpenCLIP-B. Despite its smaller size, the base model exhibits significantly higher L2-norm values compared to the larger variant, indicating a greater susceptibility to artifacts. This further supports the observation that smaller models are affected by high-norm tokens. In some cases like this one, they can be more affected}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Attention maps generated by DINOv2-G without registers (left) and with registers (right). We observe that registers are instrumental in cleaning the attention map representations.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:att_maps_registers}{{5}{10}{Attention maps generated by DINOv2-G without registers (left) and with registers (right). We observe that registers are instrumental in cleaning the attention map representations}{figure.caption.16}{}}
