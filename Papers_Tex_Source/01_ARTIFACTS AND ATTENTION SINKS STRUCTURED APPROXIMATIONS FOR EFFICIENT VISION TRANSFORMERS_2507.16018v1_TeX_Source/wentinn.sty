\newcommand\pd[3]{
	\ifthenelse{\equal{\detokenize{#3}}{\detokenize{1}}}{
		\frac{\partial #1}{\partial #2}
	}{
		\frac{\partial^{#3} #1}{\partial #2^{#3}}
	}
}
\newcommand\dv[3]{
	\ifthenelse{\equal{\detokenize{#3}}{\detokenize{1}}}{
		\frac{d #1}{d #2}
	}{
		\frac{d^{#3} #1}{d #2^{#3}}
	}
}
\newcommand\cpd[3]{
	\p{\frac{\partial #1}{\partial #2}}_{#3}
}

